{
  "manifest_version": 3,
  "name": "Vexel",
  "version": "0.2.2",
  "description": "Command Palette locale (~/.agents/skills), anti-troncation et acceleration DOM.",
  "permissions": [
    "clipboardWrite",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:49152/*",
    "http://localhost:49152/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://google.com",
        "https://google.com?*",
        "https://google.comsearch*",
        "https://google.fr",
        "https://google.fr?*",
        "https://google.frsearch*",
        "https://google.com*",
        "https://google.fr*"
      ],
      "all_frames": false,
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
