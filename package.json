{
  "name": "vexel",
  "version": "0.2.5",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "dev:bridge": "pnpm --filter @vexel/bridge dev",
    "dev:ext": "pnpm --filter @vexel/extension dev",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "pnpm test:unit && pnpm test:dom && pnpm test:e2e",
    "test:unit": "LINGUI_CONFIG=packages/extension/lingui.config.ts vitest run --project unit",
    "test:dom": "LINGUI_CONFIG=packages/extension/lingui.config.ts vitest run --project dom",
    "test:e2e": "pnpm build && node packages/extension/test/e2e/run-e2e.ts",
    "zip:store": "pnpm build && node scripts/build-store-zips.ts",
    "marketing:assets": "node scripts/capture-live-assets.ts",
    "marketing:mock": "pnpm build && node scripts/generate-store-assets.ts",
    "store:validate": "extship --validate-only",
    "store:sync": "pnpm zip:store && extship --target all",
    "store:dry-run": "pnpm zip:store && extship --dry-run --target all",
    "i18n:extract": "pnpm --filter @vexel/extension exec lingui extract",
    "i18n:check": "pnpm --filter @vexel/extension exec lingui check missing --mode catalog",
    "store:sync:chrome": "pnpm zip:store && extship --target chrome",
    "store:sync:edge": "pnpm zip:store && extship --target edge",
    "store:sync:firefox": "pnpm zip:store && extship --target firefox",
    "typecheck": "pnpm --filter @vexel/extension exec tsc -p ../../tsconfig.json --noEmit && pnpm --filter @vexel/extension exec tsc --noEmit"
  },
  "devDependencies": {
    "@lingui/vite-plugin": "^6.12.0",
    "@types/node": "^26.6.6",
    "happy-dom": "^21.0.4",
    "linkedom": "^0.18.15",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "playwright": "^1.65.1",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  }
}



