{
  "name": "vexel",
  "version": "0.2.1",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "dev:bridge": "pnpm --filter @vexel/bridge dev",
    "dev:ext": "pnpm --filter @vexel/extension dev",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "pnpm test:unit && pnpm test:dom && pnpm test:e2e",
    "test:unit": "vitest run --project unit",
    "test:dom": "vitest run --project dom",
    "test:e2e": "pnpm build && node packages/extension/test/e2e/run-e2e.mjs",
    "zip:store": "pnpm build && mkdir -p release && rm -f release/vexel-extension-store.zip && (cd packages/extension/dist && zip -r ../../../release/vexel-extension-store.zip .)",
    "marketing:assets": "node scripts/capture-live-assets.mjs",
    "marketing:mock": "pnpm build && node scripts/generate-store-assets.mjs",
    "store:validate": "node scripts/sync-store-listing.mjs --validate-only",
    "store:sync": "pnpm zip:store && node scripts/sync-store-listing.mjs",
    "store:dry-run": "node scripts/sync-store-listing.mjs --dry-run"
  },
  "devDependencies": {
    "happy-dom": "^21.0.4",
    "linkedom": "^0.18.15",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "playwright": "^1.65.1",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  }
}
