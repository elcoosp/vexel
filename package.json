{
  "name": "vexel",
  "version": "0.2.1",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "dev:bridge": "pnpm --filter @vexel/bridge dev",
    "dev:ext": "pnpm --filter @vexel/extension dev",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "pnpm test:unit && pnpm test:dom && pnpm test:e2e",
    "test:unit": "vitest run --project unit",
    "test:dom": "vitest run --project dom",
    "test:e2e": "pnpm build && node packages/extension/test/e2e/run-e2e.mjs"
  },
  "devDependencies": {
    "happy-dom": "^21.0.4",
    "linkedom": "^0.18.15",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "playwright": "^1.65.1",
    "vitest": "^5.1.0"
  }
}
