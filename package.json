{
  "name": "vexel",
  "version": "0.2.1",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "dev:bridge": "pnpm --filter @vexel/bridge dev",
    "dev:ext": "pnpm --filter @vexel/extension dev",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "devDependencies": {
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0"
  }
}
